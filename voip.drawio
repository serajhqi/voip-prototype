                <mxCell id="e_call_job" value="enqueues (polymorphic)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;jettySize=auto;startArrow=ERmandOne;startFill=0;startSize=10;endArrow=ERzeroToMany;endFill=0;endSize=10;strokeColor=#5A6B7B;strokeWidth=1.3;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;dashPattern=6 4;" parent="1" source="tbl_raw_call" target="tbl_job" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="n_identity" value="&lt;b&gt;Identity resolution&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. &lt;i&gt;sip_id&lt;/i&gt; → STAFF_SIP_ACCOUNT.extension = staff_id&lt;br&gt;2. from/to number → PHONE_NUMBER.e164 = customer_id&lt;br&gt;3. no match → customer_id stays NULL, call is still stored&lt;br&gt;4. after the call → link or create USER, set resolved_at + resolution_method&lt;br&gt;&lt;br&gt;A call is never blocked by an unknown caller." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff7e6;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="940" y="900" width="300" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="n_snapshot" value="&lt;b&gt;Snapshots, not live joins&lt;/b&gt;&lt;br&gt;&lt;br&gt;CALL_ANALYSIS.customer_id / staff_id are frozen at analysis time.&lt;br&gt;Re-resolving or merging a customer later must not rewrite history.&lt;br&gt;Re-running analysis inserts revision + 1." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff7e6;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="1720" y="1000" width="340" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="n_legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;&lt;b&gt;PK&lt;/b&gt; primary key &amp;#160;·&amp;#160; &lt;i&gt;FK&lt;/i&gt; foreign key &amp;#160;·&amp;#160; UK unique&lt;br&gt;Arrow heads: exactly one &amp;#160;→&amp;#160; zero or many&lt;br&gt;Dashed edge = polymorphic reference (entity_type + entity_id), no real FK&lt;br&gt;&lt;br&gt;&lt;b&gt;Design rules&lt;/b&gt;&lt;br&gt;• RAW_CALL is the source of truth; every derived row points back to a call.&lt;br&gt;• Transcript is step 1 output, CALL_ANALYSIS is step 2 output — separate tables, separate jobs.&lt;br&gt;• Points and tags are join rows with a subject, so they can be attributed to a call, a staff member or a customer.&lt;br&gt;• Config tables (purple) are the admin-defined input: they make scores comparable across time.&lt;br&gt;• One REPORT table with a scope replaces DailyReport / MonthlyReport and adds weekly + overall." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff7e6;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1400" width="940" height="210" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>