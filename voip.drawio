                <mxCell id="p2_notif" value="NOTIFICATION&lt;br&gt;&lt;font color='#666666'&gt;popup to staff&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1">
