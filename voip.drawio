                <mxCell id="p2_l6" value="on analysis create" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#5A6B7B;strokeWidth=1.3;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2_ca" target="p2_sjob">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p2_l7" value="accepted actions" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#5A6B7B;strokeWidth=1.3;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2_sjob" target="p2_sch">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p2_l8" value="popup" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#5A6B7B;strokeWidth=1.3;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2_sch" target="p2_notif">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p2_l9" value="unknown caller" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#5A6B7B;strokeWidth=1.3;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="p2_raw" target="p2_ident">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p2_l10" value="backfill customer_id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#5A6B7B;strokeWidth=1.3;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="p2_ident" target="p2_raw">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p2_l11" value="aggregates" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;startArrow=none;strokeColor=#5A6B7B;strokeWidth=1.3;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2_cron" target="p2_report">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p2_n1" value="&lt;b&gt;Why two steps?&lt;/b&gt;&lt;br&gt;Transcription is mechanical: speech → text, segments and a brief.&lt;br&gt;Analysis is the LLM step: it needs the transcript, the customer and staff history, the points/tags catalogue, the criteria and the prompt version (ANALYSIS_CONFIG)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff7e6;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;fontColor=#333333;" vertex="1" parent="1">
                    <mxGeometry x="520" y="300" width="420" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="p2_n2" value="&lt;b&gt;Report inputs&lt;/b&gt;&lt;br&gt;REPORT.metrics are computed from RAW_CALL (volume, talk time, missed calls), CALL_ANALYSIS (quality, urgency, points, tags) and SCHEDULE (open / done / overdue).&lt;br&gt;The narrative covers the staff member's descriptive + workload view and the customer's need, purchase willingness and how much effort the account deserves." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff7e6;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;fontColor=#333333;" vertex="1" parent="1">
                    <mxGeometry x="520" y="560" width="700" height="150" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
